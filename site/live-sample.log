## 1. Install: two static binaries and a demo shop (the tenant site)

[16:09:58] laptop$ scp -i ~/.ssh/limitplane_azure -o LogLevel=ERROR bin/limitplane bin/limitplane-xdp azureuser@104.208.118.64:~/

[16:10:05] site$ mkdir -p shop && printf '<h1>XYZ Shop</h1><p>Real tenant site, port 8080.</p>\n' > shop/index.html

[16:10:06] site$ cat > lp.json <<J
{"upstream":"http://127.0.0.1:8080","port":80,"adminKey":"<admin-key>",
 "policy":{"tiers":{"free":{"capacity":20,"refillPerSecond":1}},"routes":{"*":{"costClass":"light"}}}}
J

[16:10:08] site$ nohup python3 -m http.server 8080 --bind 127.0.0.1 -d shop >shop.log 2>&1 & sleep 1; curl -s -o /dev/null -w "shop direct: %{http_code}\n" http://127.0.0.1:8080/
shop direct: 200

[16:10:11] site$ sudo nohup ./limitplane --config lp.json >proxy.log 2>&1 & sleep 1; tail -3 proxy.log
time=2026-10-22T16:10:12.656Z level=INFO msg="using policy from file" path=lp.json
time=2026-10-22T16:10:12.657Z level=INFO msg="identifying visitors by socket address; pass --trust-proxy if a load balancer of yours sits in front"
time=2026-10-22T16:10:12.657Z level=INFO msg="limitplane proxy up" listen=http://localhost:80 upstream=http://127.0.0.1:8080 dashboard=http://localhost:80/_limitplane/dashboard

[16:10:13] site$ sudo LIMITPLANE_ADMIN_KEY=<admin-key> nohup ./limitplane-xdp -iface eth0 -gateway http://127.0.0.1:80 -rate 2000 -burst 4000 >xdp.log 2>&1 & sleep 2; cat xdp.log
2026/10/22 16:10:15 INFO attached iface=eth0 mode=generic rate_pps=2000 burst=4000 pin=/sys/fs/bpf/limitplane

[16:10:17] site$ sudo ./limitplane-xdp stats
passed=67 dropped_banned=0 dropped_rate=0 banned_ips=0

