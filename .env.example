# Copy to .env and fill in. Run with: node --env-file=.env src/server.js
# All optional — everything degrades gracefully without them.

# AI-written incident notes on autopilot alerts + /v1/admin/explain (Groq)
GROQ_API_KEY=

# Stripe billing automation (without these: demo mode + /v1/billing/simulate)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Where the autopilot POSTs alerts (Slack/Discord-compatible JSON, `text` field)
ALERT_WEBHOOK_URL=

# Persist tenant tiers across restarts (JSON file path)
TENANTS_FILE=
